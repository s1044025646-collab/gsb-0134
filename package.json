{
  "name": "local-rs-erasure-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-only Reed-Solomon erasure coding stripe encoder and recovery backend (TypeScript + Node.js + SQLite).",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "ec": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/server.js",
    "dev": "node --experimental-sqlite --import tsx src/server.ts",
    "cli": "node --experimental-sqlite --import tsx src/cli/index.ts",
    "demo": "node --experimental-sqlite --import tsx scripts/demo.ts",
    "test": "node --experimental-sqlite --import tsx --test test/*.test.ts",
    "stop": "node --experimental-sqlite --import tsx scripts/stop.ts",
    "clean": "node --experimental-sqlite --import tsx scripts/clean.ts"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
